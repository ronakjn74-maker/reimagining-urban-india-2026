{
  "name": "reimagining-urban-india-2026",
  "private": true,
  "description": "Static event website for the 41st National Convention of Architectural Engineers",
  "scripts": {
    "start": "http-server . -p 8080 -c-1 -o",
    "serve": "http-server . -p 8080 -c-1 --silent",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "clean": "rm -rf node_modules test-results playwright-report"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "http-server": "14.1.1"
  }
}
